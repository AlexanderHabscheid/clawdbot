# Centris AI — Environment Variables
#
# Quick start:
# 1) Copy this file to `.env` (for local runs) or set vars in your Railway service.
# 2) Fill only the values you use.
# 3) Keep real secrets out of git — use Railway's variable management for production.
#
# Env-source precedence (highest → lowest):
# process env → ./.env → ~/.openclaw/.env → openclaw.json `env` block.
# Existing non-empty process env vars are not overridden by dotenv/config loading.

# =============================================================================
# GATEWAY (required for Railway / cloud deployment)
# =============================================================================
# Auth token protects the gateway when bound beyond loopback (required on Railway).
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token
# Generate one: openssl rand -hex 32

# Alternative auth mode (use token OR password, not both).
# OPENCLAW_GATEWAY_PASSWORD=

# Railway injects PORT automatically — the entrypoint bridges it to the gateway.
# Do NOT set PORT manually on Railway.

# =============================================================================
# MODEL PROVIDER API KEYS (set at least one)
# =============================================================================
# Centris defaults to google/gemini-2.5-flash-lite (set in centris-init.sh).
# Set the key for whichever provider(s) you want available.

# Google Gemini (default for Centris)
# GEMINI_API_KEY=

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (multi-provider gateway)
# OPENROUTER_API_KEY=sk-or-...

# Additional providers
# ZAI_API_KEY=
# AI_GATEWAY_API_KEY=
# MINIMAX_API_KEY=
# SYNTHETIC_API_KEY=
# XIAOMI_API_KEY=

# =============================================================================
# CENTRIS-SPECIFIC (voice, browser extension, desktop)
# =============================================================================
# Deepgram — required for voice features (STT streaming via WebSocket).
# Without this key, /ws/centris/voice will return an error to clients.
# DEEPGRAM_API_KEY=

# Chrome extension connection token (optional).
# If set, only extensions presenting this token can connect.
# If unset, all extension connections are accepted.
# CENTRIS_EXTENSION_TOKEN=

# Desktop app gateway URL override (Electron contextCollector).
# Default: https://centris-gateway.a-7cd.workers.dev
# CENTRIS_GATEWAY_URL=

# =============================================================================
# SDK PACKAGE PUBLISHING (never commit real tokens)
# =============================================================================
# npm publish token for @centris/sdk (granular token with org/package publish rights)
# NPM_TOKEN=
#
# PyPI API token for centris-sdk publishing
# TWINE_USERNAME=__token__
# TWINE_PASSWORD=pypi-...

# =============================================================================
# CHANNELS (only set what you enable)
# =============================================================================
# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# MATTERMOST_BOT_TOKEN=
# MATTERMOST_URL=https://chat.example.com
# ZALO_BOT_TOKEN=
# OPENCLAW_TWITCH_ACCESS_TOKEN=oauth:...

# =============================================================================
# TOOLS + SEARCH (optional)
# =============================================================================
# Brave Search — used by web_search tool.
# BRAVE_API_KEY=

# Perplexity — fallback search provider.
# PERPLEXITY_API_KEY=pplx-...

# Firecrawl — used by web_fetch tool for rendered page content.
# FIRECRAWL_API_KEY=

# xAI — used by web_search for Grok-powered results.
# XAI_API_KEY=

# =============================================================================
# VOICE / MEDIA (optional)
# =============================================================================
# ElevenLabs TTS
# ELEVENLABS_API_KEY=
# XI_API_KEY=            # alias for ElevenLabs

# =============================================================================
# CLOUDFLARE (AI Gateway proxy + DNS/CDN)
# =============================================================================
# Account ID and Zone ID for Cloudflare services.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=

# Cloudflare AI Gateway API key (if routing model calls through CF AI Gateway).
# Account ID + Gateway ID are stored in openclaw.json auth profile metadata.
# CLOUDFLARE_AI_GATEWAY_API_KEY=

# =============================================================================
# SUPABASE (cloud sync, auth, database)
# =============================================================================
# SUPABASE_URL=https://<project-id>.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_SERVICE_KEY=eyJ...  # alias for service role (web memory store)
# DATABASE_URL=postgresql://postgres:<password>@db.<project-id>.supabase.co:5432/postgres
#
# Per-user web memory (see docs/MEMORY_ARCHITECTURE.md):
# CENTRIS_MEMORY_STORAGE=supabase  # use Supabase when userId present; default: local (in-memory)

# =============================================================================
# GATEWAY BEHAVIOR FLAGS (optional, rarely needed)
# =============================================================================
# Skip subsystems that aren't needed on Railway to reduce startup time.
# OPENCLAW_SKIP_GMAIL_WATCHER=1
# OPENCLAW_SKIP_CHANNELS=1
# OPENCLAW_SKIP_CRON=1

# Import missing keys from login shell (useful for local dev, not Railway).
# OPENCLAW_LOAD_SHELL_ENV=1
# OPENCLAW_SHELL_ENV_TIMEOUT_MS=15000

# Path overrides (defaults are fine for Railway/Docker).
# OPENCLAW_STATE_DIR=~/.openclaw
# OPENCLAW_CONFIG_PATH=~/.openclaw/openclaw.json
