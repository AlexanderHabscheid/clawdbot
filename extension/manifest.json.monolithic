{
  "manifest_version": 3,
  "name": "Centris AI - Voice Control Your Computer",
  "version": "2.0.4",
  "description": "Voice-controlled AI that automates your browser. Control Gmail, Slack, and any website with voice commands.",
  
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "windows",
    "nativeMessaging",
    "debugger",
    "alarms"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["Readability.js", "content.js"],
      "matches": ["<all_urls>"]
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Centris AI"
  },
  
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "https://*.sentris.io/*"
    ]
  }
}

