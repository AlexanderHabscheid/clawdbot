{
  "name": "centris-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Centris Desktop Application - Voice-controlled computer using Centris backend",
  "keywords": [
    "ai",
    "assistant",
    "centris",
    "desktop-app",
    "electron",
    "voice-control"
  ],
  "license": "MIT",
  "author": "Centris",
  "main": "main.js",
  "scripts": {
    "build": "npm run build:renderer && electron-builder",
    "build:all": "npm run build:renderer && npm run compile:all && electron-builder --mac --win --linux",
    "build:dir": "npm run build:renderer && electron-builder --dir --config.mac.identity=null",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "build:mac": "npm run build:renderer && npm run compile:all && electron-builder --mac",
    "build:mac:unsigned": "npm run build:renderer && npm run compile:all && electron-builder --mac --config.mac.identity=null",
    "build:renderer": "cd src && vite build",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:win:dir": "npm run build:renderer && electron-builder --win --dir",
    "build:win:installer": "npm run build:renderer && electron-builder --win nsis",
    "build:win:portable": "npm run build:renderer && electron-builder --win portable",
    "clear-caches": "node scripts/clear-all-vite-electron-caches.js",
    "clear-caches-old": "node scripts/clear-onboarding-complete.js && node -e \"const fs=require('fs');const os=require('os');const path=require('path');const appData=path.join(os.homedir(),process.platform==='darwin'?'Library/Application Support':process.platform==='win32'?'AppData/Roaming':'.config','Centris AI');['Cache','Code Cache','GPUCache','ShaderCache'].forEach(d=>{try{fs.rmSync(path.join(appData,d),{recursive:true,force:true});console.log('✅ Cleared',d);}catch(e){}});try{fs.rmSync(path.join(os.homedir(),'Library/Caches/Centris AI'),{recursive:true,force:true});console.log('✅ Cleared system cache');}catch(e){};console.log('✅ All caches cleared!');\"",
    "compile:all": "npm run compile:globe && npm run compile:fn-space && npm run compile:text-inserter",
    "compile:fn-space": "mkdir -p resources/bin && clang -framework ApplicationServices -framework Carbon -o resources/bin/macos-fn-space-listener resources/macos-fn-space-listener.c && chmod +x resources/bin/macos-fn-space-listener",
    "compile:globe": "mkdir -p resources/bin && clang -framework IOKit -framework CoreFoundation -o resources/bin/macos-globe-listener resources/macos-globe-listener.c && chmod +x resources/bin/macos-globe-listener",
    "compile:text-inserter": "mkdir -p resources/bin && clang -framework Foundation -framework ApplicationServices -framework Carbon -fobjc-arc -o resources/bin/macos-text-inserter resources/macos-text-inserter.m && chmod +x resources/bin/macos-text-inserter",
    "dev": "node scripts/clear-caches-startup.js && concurrently -k -r \"npm:dev:renderer\" \"npm:dev:main\"",
    "dev:app": "node scripts/dev-app.js",
    "dev:app:watch": "node scripts/dev-app.js --watch",
    "dev:main": "cross-env NODE_ENV=development electron . --dev",
    "dev:renderer": "cd src && vite --force",
    "dev:win": "cross-env NODE_ENV=development npm run dev",
    "lint": "cd src && eslint .",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "predev": "node scripts/ensure-desktop-dev-deps.js",
    "publish": "npm run build:renderer && npm run compile:all && electron-builder --mac --publish always",
    "publish:win": "npm run build:renderer && electron-builder --win --publish always",
    "release": "./scripts/release-macos.sh",
    "release:linux": "npm run build:renderer && electron-builder --linux",
    "release:unsigned": "./scripts/build-unsigned.sh",
    "release:win": "npm run build:renderer && electron-builder --win",
    "reset-onboarding": "node scripts/clear-onboarding-and-preferences.js",
    "start": "npm run build:renderer && electron ."
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "axios": "^1.6.2",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.3.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.518.0",
    "ogl": "^1.0.11",
    "onnxruntime-web": "^1.23.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn-ui": "^0.9.5",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "chokidar": "^3.6.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.0.0",
    "electron": "^36.5.0",
    "electron-builder": "^24.6.4",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.10",
    "vite": "^6.3.5"
  },
  "optionalDependencies": {
    "node-mac-permissions": "^2.3.0"
  },
  "build": {
    "appId": "com.centris.app",
    "productName": "Centris AI",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "centris-ai",
      "repo": "centris-desktop",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Centris AI needs microphone access to record your voice for transcription and voice commands.",
        "NSAccessibilityUsageDescription": "Centris AI needs accessibility access to insert transcribed text into applications and detect the activation hotkey.",
        "NSScreenCaptureUsageDescription": "Centris AI needs screen recording access to understand visual context and help navigate your computer.",
        "NSAppleEventsUsageDescription": "Centris AI needs automation access to control other applications on your behalf."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "src/assets/icon.icns",
      "background": "src/assets/dmg-background.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 400
      },
      "format": "UDZO"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico",
      "publisherName": "Centris AI",
      "verifyUpdateCodeSignature": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Centris AI",
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico",
      "license": "LICENSE",
      "runAfterFinish": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "resources/**/*",
      "!src/**/*.md"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "**/*.onnx",
          "**/*.tflite"
        ]
      },
      {
        "from": "resources/windows-text-inserter.ps1",
        "to": "windows-text-inserter.ps1"
      },
      {
        "from": "../extension/native-host",
        "to": "native-host",
        "filter": [
          "centris_host.py",
          "com.centris.host.json",
          "README.md"
        ]
      }
    ]
  }
}
